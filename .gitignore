# ---------- Terraform ----------

# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version
# control as they are data points which are potentially sensitive and subject
# to change depending on the environment.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Saved plan files can contain sensitive values
*.tfplan
tfplan
planout

# Ignore CLI configuration files
.terraformrc
terraform.rc

# ---------- Secrets ----------

# Azure Functions local settings — contains AzureWebJobsStorage
# connection strings and account keys in plaintext. Never commit.
local.settings.json

# Local environment files
.env
.env.*

# Certificates and publish profiles carry credentials
*.pfx
*.publishsettings
*.azurePubxml
PublishScripts/

# ---------- .NET build output ----------

[Bb]in/
[Oo]bj/
[Ll]og/
publish/
artifacts/
*.publishproj

# ---------- Test results ----------

[Tt]est[Rr]esult*/
*.VisualState.xml
TestResult.xml

# ---------- Editors & IDEs ----------

# JetBrains (Rider / IntelliJ)
.idea/
*.sln.iml
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# macOS metadata
.DS_Store

# ---------- Other languages (in case a sample lands here) ----------

node_modules/
__pycache__/
*.pyc
.venv/
venv/
